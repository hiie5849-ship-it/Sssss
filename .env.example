# ZappKart Multi-Vendor Marketplace Environment Variables Template
# Copy this file to .env for local development

# PORT: The port the server will listen on (default 3000)
PORT=3000

# APP_URL: The base URL of the hosted applet or localhost
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing and verifying authentication tokens
JWT_SECRET="replace_with_a_secure_random_jwt_secret_32_chars_min"

# RAZORPAY_KEY_ID: Razorpay Gateway Key ID (Test key starts with rzp_test_)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# RAZORPAY_KEY_SECRET: Razorpay Gateway Secret (Keep secure on server only)
RAZORPAY_KEY_SECRET="placeholder_secret_key"

# SUPER_ADMIN_EMAIL: Initial email for Super Admin provisioning
SUPER_ADMIN_EMAIL="admin@zappkart.com"

# SUPER_ADMIN_PASSWORD: Initial setup password for Super Admin
SUPER_ADMIN_PASSWORD="AdminSecurePassword123!"

# ENABLE_TEST_PAYMENTS: Set to "true" to enable simulated card/UPI/netbanking for sandbox verification
ENABLE_TEST_PAYMENTS="true"

# GEMINI_API_KEY: Optional Gemini API key if AI assistance is enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"
